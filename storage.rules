rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function image() { return request.resource != null && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    match /pets/{uid}/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && resource == null && image()
        && firestore.get(/databases/(default)/documents/profiles/$(uid)).data.role == 'ong';
    }
    match /homes/{uid}/{applicationId}/{file} {
      allow read: if signedIn() && (request.auth.uid == uid ||
        (firestore.get(/databases/(default)/documents/applications/$(applicationId)).data.ongId == request.auth.uid
         && firestore.get(/databases/(default)/documents/applications/$(applicationId)).data.applicantId == uid));
      allow write: if signedIn() && request.auth.uid == uid && resource == null && image()
        && firestore.get(/databases/(default)/documents/profiles/$(uid)).data.role == 'donor';
    }
    match /avatars/{uid}/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && resource == null && image();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
