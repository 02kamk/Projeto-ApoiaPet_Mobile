EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Backend on Vercel (project with Root Directory = backend), e.g. https://apoiapet-api.vercel.app
# Local: http://localhost:3000 with `vercel dev` inside backend/ (Android Emulator: http://10.0.2.2:3000)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_PAYMENTS_ENABLED=false
EXPO_PUBLIC_USE_EMULATORS=false
# Leave empty for browser/iOS simulator, or Android Emulator (10.0.2.2).
EXPO_PUBLIC_EMULATOR_HOST=
