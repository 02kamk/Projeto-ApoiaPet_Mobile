# Vercel → Settings → Environment Variables. Never commit real values.
# Service account JSON (Firebase Console → Project settings → Service accounts → Generate new private key), in one line.
FIREBASE_SERVICE_ACCOUNT=
# Blob: on Vercel, connecting the PRIVATE store to the project sets BLOB_STORE_ID/VERCEL_OIDC_TOKEN automatically.
# Locally (vercel dev / tests against a real store) use a read-write token instead:
BLOB_READ_WRITE_TOKEN=
# Browser origins allowed to call the API (Expo web). Native apps need nothing here. Comma separated.
ALLOWED_ORIGINS=http://localhost:8081
# Mercado Pago (only when PAYMENTS_ENABLED=true)
PAYMENTS_ENABLED=false
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
APP_URL=https://SEU-APP-HTTPS
BACKEND_URL=https://SEU-PROJETO.vercel.app
# Local only: talk to the Firebase emulators instead of the real project.
# FIREBASE_PROJECT_ID=demo-apoiapet
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
